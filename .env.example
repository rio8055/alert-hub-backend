APP_NAME=Alert Hub
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/alert_hub
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173

# Absolute base URL of this API (no trailing path). Used for /media/... links in notifications.
# In production set to your deployed API origin, e.g. https://your-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# VAPID keys for web push. Generate once and reuse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com

# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
