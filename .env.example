APP_NAME=Alert Hub
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/alert_hub
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated browser origins allowed to call the API (with credentials). Add your production frontend.
# Vercel: https://your-app.vercel.app — *.vercel.app is also allowed via regex in main.py.
# Render: https://your-service.onrender.com — *.onrender.com is also allowed via regex in main.py.
# If the browser still reports CORS after deploy, set this to true (Bearer-token API only; see app/core/config.py).
CORS_ALLOW_ANY_ORIGIN=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://alert-hub-frontend.vercel.app

# Absolute base URL of this API (no trailing path). Used for /media/... links in notifications.
# In production set to your deployed API origin, e.g. https://your-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# VAPID keys for web push. Generate once and reuse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com

# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Cloudflare R2 (S3-compatible). Create bucket + "Manage R2 API Tokens" in the dashboard.
# Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com — no bucket name in the path.
# Put real values in .env or host secrets only; never commit secrets.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: public HTTPS base for objects if you use a custom domain on the bucket (no trailing slash).
# R2_PUBLIC_BASE_URL=https://media.example.com
